{
    "version": "1",
    "priority": "0",
    "presets": [
        {
            "name": "default",
            "config": [
                {
                    "target_name": "libskl-core",
                    "constexpr_namespace": "skl",
                    "default_output": "public",
                    "constexprs": {
                        "CCurrentCppVersion": {
                            "value": "@CMAKE_CXX_STANDARD@",
                            "type": "u32"
                        },
                        "CPathMaxLength": {
                            "value": "512U",
                            "type": "u32"
                        },
                        "SklRandStride": {
                            "value": "0x9E3779B97F4A7C15ULL",
                            "type": "u64",
                            "desc": "[Tune] skl_rand state stride (position multiplier in the stateless form). MUST BE ODD - an even value drops the top bits of the position and shortens the stream period below 2^64"
                        },
                        "SklRandMul_MIX1": {
                            "value": "0xBF58476D1CE4E5B9ULL",
                            "type": "u64",
                            "desc": "[Tune] skl_rand finalizer multiplier 1. MUST BE ODD"
                        },
                        "SklRandMul_MIX2": {
                            "value": "0x94D049BB133111EBULL",
                            "type": "u64",
                            "desc": "[Tune] skl_rand finalizer multiplier 2. MUST BE ODD"
                        },
                        "SklRand2D_PRIME": {
                            "value": "0xD6E8FEB86659FD93ULL",
                            "type": "u64",
                            "desc": "[Tune] skl_rand 2d coordinate mixing prime"
                        },
                        "SklRand3D_PRIME1": {
                            "value": "0xA24BAED4963EE407ULL",
                            "type": "u64",
                            "desc": "[Tune] skl_rand 3d coordinate mixing prime 1"
                        },
                        "SklRand3D_PRIME2": {
                            "value": "0x9FB21C651E98DF25ULL",
                            "type": "u64",
                            "desc": "[Tune] skl_rand 3d coordinate mixing prime 2"
                        },
                        "CSerializedLoggerThreadBufferSize": {
                            "value": "4096U",
                            "type": "u64",
                            "desc": "Size of the serialized logger front end buffer. [min=4096]"
                        }
                    },
                    "constexprs.reporting": {
                        "CSklReportingThreadBufferSize": {
                            "value": "1048576ULL",
                            "type": "u64",
                            "desc": "[Tune] Skylake Core stats reporting thread buffer (must be a power of 2)"
                        }
                    },
                    "defines": {
                        "SKL_ASSERT_LEVEL": {
                            "value": "2",
                            "desc": "Current skylake assert level: 0=NO ASSERTS(Release) 1=CRITICAL ASSERTS(Test) 2=ALL ASSERTS(Dev)"
                        },
                        "SKL_ASSERT_LEVEL_NONE": {
                            "value": "0",
                            "desc": "Skylake assert level: 0=NO ASSERTS(Release)"
                        },
                        "SKL_ASSERT_LEVEL_CRITICAL": {
                            "value": "1",
                            "desc": "Skylake assert level: 1=CRITICAL ASSERTS(Test)"
                        },
                        "SKL_ASSERT_LEVEL_ALL": {
                            "value": "2",
                            "desc": "Skylake assert level:2=ALL ASSERTS(Dev)"
                        },
                        "SKL_CORE_EXTERNAL_ALLOC": {
                            "value": "1",
                            "desc": "Memory allocations for data structures should be defined externally (eg. using rte_malloc for hugepages)"
                        },
                        "SKL_ENABLE_LOG_COLORS": {
                            "value": "1",
                            "desc": "Enable SLogger ansi collored output"
                        },
                        "SKL_SMP": {
                            "value": "0",
                            "desc": "Enable SMP (multi-core) support in Skylake Core"
                        }
                    }
                }
            ]
        }
    ]
}
